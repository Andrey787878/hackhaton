digraph ER {
graph [rankdir=TB, bgcolor="white", pad="0.15", nodesep="0.35", ranksep="0.65", splines=polyline];
node [shape=plain, fontname="Arial", fontsize=13];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.65];
"cases" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>cases</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">hackathon_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(200)</FONT></TD></TR></TABLE>>];
"criteria" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>criteria</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">case_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">min_score</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">max_score</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">weight</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NUMERIC(10, 4)</FONT></TD></TR></TABLE>>];
"hackathons" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>hackathons</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">organizer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT">starts_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT">deadline_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
"invites" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>invites</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">team_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">revoked_at</TD><TD ALIGN="LEFT"><FONT COLOR="#475569"> ?</FONT></TD></TR></TABLE>>];
"team_members" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>team_members</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">team_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">hackathon_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR></TABLE>>];
"teams" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>teams</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">hackathon_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">captain_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(100)</FONT></TD></TR></TABLE>>];
"hackathons" -> "cases" [label="hackathon_id\n1 : 0..N"];
"cases" -> "criteria" [label="case_id\n1 : 0..N"];
"teams" -> "invites" [label="team_id\n1 : 0..N"];
"teams" -> "team_members" [label="team_id+hackathon_id\n1 : 0..N"];
"hackathons" -> "teams" [label="hackathon_id\n1 : 0..N"];
}