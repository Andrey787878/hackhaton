digraph ER {
graph [rankdir=TB, bgcolor="white", pad="0.15", nodesep="0.35", ranksep="0.65", splines=polyline];
node [shape=plain, fontname="Arial", fontsize=13];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.65];
"expert_assignments" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>expert_assignments</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">submission_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">expert_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR><TR><TD ALIGN="LEFT">assigned_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR></TABLE>>];
"notifications" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>notifications</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT">resource_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">INTEGER</FONT></TD></TR></TABLE>>];
"scores" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>scores</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">assignment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">criterion_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; criteria</FONT></TD></TR><TR><TD ALIGN="LEFT">value</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">INTEGER</FONT></TD></TR></TABLE>>];
"stored_objects" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>stored_objects</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">object_key</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT">size_bytes</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">sha256</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(64)</FONT></TD></TR></TABLE>>];
"submissions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>submissions</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">team_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; teams</FONT></TD></TR><TR><TD ALIGN="LEFT">case_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; cases</FONT></TD></TR><TR><TD ALIGN="LEFT">submitted_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR><TR><TD ALIGN="LEFT">url</TD><TD ALIGN="LEFT"><FONT COLOR="#475569"> ?</FONT></TD></TR><TR><TD ALIGN="LEFT">stored_object_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK ?</FONT></TD></TR></TABLE>>];
"submissions" -> "expert_assignments" [label="submission_id\n1 : 0..N",constraint=false];
"expert_assignments" -> "scores" [label="assignment_id\n1 : 0..N"];
"stored_objects" -> "submissions" [label="stored_object_id\n0..1 : 0..1"];
{rank=same; stored_objects; notifications;}
{rank=same; submissions; expert_assignments;}
}