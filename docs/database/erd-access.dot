digraph ER {
graph [rankdir=TB, bgcolor="white", pad="0.15", nodesep="0.35", ranksep="0.65", splines=polyline];
node [shape=plain, fontname="Arial", fontsize=13];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.65];
"auth_sessions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>auth_sessions</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">refresh_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(255)</FONT></TD></TR></TABLE>>];
"permission_role" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>permission_role</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">permission_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR><TR><TD ALIGN="LEFT">deleted_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users ?</FONT></TD></TR></TABLE>>];
"permissions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>permissions</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR><TR><TD ALIGN="LEFT">deleted_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users ?</FONT></TD></TR></TABLE>>];
"role_user" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>role_user</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR><TR><TD ALIGN="LEFT">deleted_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users ?</FONT></TD></TR></TABLE>>];
"roles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>roles</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users</FONT></TD></TR><TR><TD ALIGN="LEFT">deleted_by</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK &rarr; users ?</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#94a3b8"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VARCHAR(255)</FONT></TD></TR></TABLE>>];
"users" -> "auth_sessions" [label="user_id\n1 : 0..N"];
"roles" -> "permission_role" [label="role_id\n1 : 0..N"];
"permissions" -> "permission_role" [label="permission_id\n1 : 0..N"];
"users" -> "role_user" [label="user_id\n1 : 0..N"];
"roles" -> "role_user" [label="role_id\n1 : 0..N"];
}