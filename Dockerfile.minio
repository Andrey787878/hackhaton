# Official MinIO source tag, built locally because the historical public images
# are no longer consistently available from container registries.
FROM golang:1.24.8-bookworm AS build
RUN git clone --depth 1 --branch RELEASE.2025-10-15T17-29-55Z https://github.com/minio/minio.git /src
WORKDIR /src
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/minio .

FROM debian:bookworm-slim
RUN groupadd --gid 10001 minio && useradd --uid 10001 --gid 10001 --no-create-home minio \
    && mkdir /data && chown minio:minio /data
COPY --from=build /out/minio /usr/local/bin/minio
USER 10001:10001
VOLUME /data
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
